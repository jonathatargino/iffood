DB_URL=
DB_TYPE=postgres
SUPABASE_URL=
AWS_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_DEFAULT_REGION=

# --- Redis (dev local: standalone) ---
REDIS_URL=redis://localhost:6379
REDIS_CLUSTER=false
# REDIS_HOST=localhost
# REDIS_PORT=6379

# --- Redis (ElastiCache Valkey — modo Cluster, us-west-2) ---
# Use hostname puro do endpoint de configuração (sem redis://).
# REDIS_CLUSTER=true
# REDIS_HOST=clustercfg.iffood-load-test-cache.e2jpho.usw2.cache.amazonaws.com
# REDIS_PORT=6379
# REDIS_TLS=true
# REDIS_PASSWORD=

# ═══════════════════════════════════════════════════════════════════════════
# SQS — escolha UM modo (não misturar URL AWS com SQS_ENDPOINT LocalStack)
# ═══════════════════════════════════════════════════════════════════════════
#
# --- Modo produção / staging (fila real na conta AWS) ---
# URL copiada da consola SQS. Região deve coincidir com AWS_REGION / AWS_DEFAULT_REGION.
# Omitir SQS_ENDPOINT (ou deixar vazio). Credenciais IAM precisam de sqs:SendMessage e,
# no worker, sqs:ReceiveMessage + sqs:DeleteMessage na mesma fila.
# Para `node load-tests/setup.js`: purge usa sqs:PurgeQueue na fila (ou defina
# LOAD_TEST_SKIP_SQS_PURGE=1 para não purgar fila partilhada / sem permissão).
#
# SQS_QUEUE_URL=https://sqs.us-east-2.amazonaws.com/053169953310/order-requests
#
# --- Modo desenvolvimento local com LocalStack ---
# Com API a correr no Docker: host.docker.internal aponta para o host (Linux: extra_hosts no compose).
#
# SQS_ENDPOINT=http://host.docker.internal:4566
# SQS_QUEUE_URL=http://host.docker.internal:4566/000000000000/order-requests
#
# --- API só em máquina host (sem Docker), LocalStack em localhost:4566 ---
#
# SQS_QUEUE_URL=http://localhost:4566/000000000000/order-requests
#
# ═══════════════════════════════════════════════════════════════════════════

SQS_QUEUE_URL=http://localhost:4566/000000000000/order-requests
