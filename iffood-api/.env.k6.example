# Variáveis de ambiente para a bateria de testes k6.
#
# GERAÇÃO AUTOMÁTICA (recomendado):
#   Preencha as variáveis de setup abaixo e execute:
#     node load-tests/setup.js
#   O script criará load-tests/.env.k6 com todos os IDs corretos.
#
# PREENCHIMENTO MANUAL:
#   cp .env.k6.example .env.k6
#   Edite .env.k6 com os valores reais do seu banco.

# ─────────────────────────────────────────────────────────────────────────────
# Variáveis de INPUT para load-tests/setup.js
# (lidas do .env da raiz ou do shell — não ficam neste arquivo)
# ─────────────────────────────────────────────────────────────────────────────
#
# Obrigatórias:
#   K6_AUTH_TOKEN=Bearer eyJ...     <- token JWT do usuário de teste
#   DB_URL=postgresql://user:pass@localhost:5432/iffood
#
# Opcionais:
#   K6_BASE_URL=http://localhost:3006          (padrão)
#   LOAD_TEST_ORDER_TARGETS_COUNT=150          (padrão; ≥ pico de VUs do c1a/c4a)
#   LOAD_TEST_STORE_COUNT=10000               (padrão; meta de lojas para c2a/c2b)

# ─────────────────────────────────────────────────────────────────────────────
# Variáveis de OUTPUT geradas pelo setup.js (conteúdo do .env.k6)
# ─────────────────────────────────────────────────────────────────────────────

# ── Configuração geral ────────────────────────────────────────────────────────
K6_BASE_URL=http://localhost:3006
K6_AUTH_TOKEN=Bearer eyJ...

# ── Cenário 1A / 4A / 4B — targets de pedido (array JSON) ────────────────────
# Gerado pelo setup.js com 150 entradas (uma por VU para baixa contenção).
# Cada objeto representa um par loja/produto/opção distinto.
K6_ORDER_TARGETS='[{"storeId":"uuid-loja","productId":"uuid-produto","productOptionId":"uuid-opcao"}]'

# ── Cenário 1B — target único para alta contenção ─────────────────────────────
# Gerado pelo setup.js como ORDER_TARGETS[0] (todos os VUs atacam o mesmo lock).
K6_CONTENTION_TARGET='{"storeId":"uuid-loja","productId":"uuid-produto","productOptionId":"uuid-opcao"}'

# ── Cenário 3A / 3B — IDs de produtos para query de acoplamento ───────────────
# Gerado pelo setup.js com 8 UUIDs de produtos criados no banco.
K6_PRODUCT_IDS='["uuid-produto-1","uuid-produto-2","uuid-produto-3"]'

# ── Cenário 4 — nível de contenção (low | high) ───────────────────────────────
K6_CONTENTION=low

# ── Filtro opcional: rodar apenas testes específicos ──────────────────────────
# Descomente e liste os nomes separados por vírgula:
# K6_ONLY=c4a,c4b
